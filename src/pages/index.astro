---
import Layout from "@/layouts/Layout.astro";
import { HeroSection } from "@/components/landing/HeroSection";
import { ProjectsSection } from "@/components/landing/ProjectsSection";
---

<Layout>
  <header
    class="fixed inset-x-0 top-0 z-50 border-b border-border/60 bg-background/80 backdrop-blur-md"
  >
    <div
      class="mx-auto flex h-14 max-w-5xl items-center justify-between px-4 sm:px-6 lg:px-8"
    >
      <a
        href="/"
        class="font-mono text-sm font-medium tracking-tight text-foreground hover:text-primary"
      >
        sy<span class="text-muted-foreground">.</span>
      </a>
      <nav class="flex items-center gap-6 text-sm text-muted-foreground">
        <a href="#projects" class="transition-colors hover:text-foreground">
          Projects
        </a>
        <a
          href="mailto:hello@sametyilmaz.tech"
          class="transition-colors hover:text-foreground"
        >
          Contact
        </a>
      </nav>
    </div>
  </header>

  <main>
    <HeroSection client:load />
    <ProjectsSection client:visible />
  </main>

  <footer class="border-t border-border px-4 py-10 sm:px-6 lg:px-8">
    <div
      class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-4 sm:flex-row"
    >
      <p class="text-center text-sm text-muted-foreground sm:text-left">
        © {new Date().getFullYear()} Samet Yılmaz ·{" "}
        <a
          href="https://sametyilmaz.tech"
          class="text-foreground underline-offset-4 hover:underline"
        >
          sametyilmaz.tech
        </a>
      </p>
      <p class="font-mono text-xs text-muted-foreground">
        Astro · React · Vercel
      </p>
    </div>
  </footer>
</Layout>
