---
import Layout from "@/layouts/Layout.astro";
import SiteHeader from "@/components/layout/SiteHeader.astro";
import SiteFooter from "@/components/layout/SiteFooter.astro";
---

<Layout
  title="Page not found — Samet Yılmaz"
  description="The page you are looking for does not exist."
  noindex={true}
>
  <SiteHeader />
  <main
    id="main-content"
    tabindex="-1"
    class="flex min-h-[70vh] flex-col items-center justify-center px-4 pb-20 pt-28 text-center sm:px-6 lg:px-8"
  >
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-muted-foreground">
      404
    </p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
      This page does not exist
    </h1>
    <p class="mt-4 max-w-md text-muted-foreground">
      The link may be broken or the page was removed. Head back home or browse
      projects.
    </p>
    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <a
        href="/"
        class="inline-flex h-10 items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground shadow transition-colors hover:bg-primary/90"
      >
        Home
      </a>
      <a
        href="/#projects"
        class="inline-flex h-10 items-center justify-center rounded-md border border-input bg-background px-4 text-sm font-medium transition-colors hover:bg-muted"
      >
        Projects
      </a>
    </div>
  </main>
  <SiteFooter />
</Layout>
